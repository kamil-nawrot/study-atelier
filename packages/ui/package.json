{
	"name": "@study-atelier/ui",
	"private": true,
	"version": "0.3.1",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts",
			"default": "./src/lib/index.ts"
		},
		"./styles.css": "./src/lib/styles/index.css"
	},
	"svelte": "./src/lib/index.ts",
	"scripts": {
		"tokens": "node scripts/build-tokens.ts",
		"storybook": "storybook dev -p 6006",
		"build": "storybook build --quiet -o storybook-static",
		"check": "node scripts/build-tokens.ts --check && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint . && stylelint --config ../../stylelint.config.js \"src/**/*.{css,svelte}\"",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:coverage": "vitest --run --coverage"
	},
	"dependencies": {
		"@fontsource/newsreader": "^5.3.0",
		"@fontsource/schibsted-grotesk": "^5.3.0",
		"@lucide/svelte": "^1.55.0",
		"@tiptap/core": "^3.31.4",
		"@tiptap/markdown": "^3.31.4",
		"@tiptap/pm": "^3.31.4",
		"@tiptap/starter-kit": "^3.31.4",
		"@tiptap/suggestion": "^3.31.4",
		"dompurify": "^3.4.17",
		"marked": "^18.1.1"
	},
	"devDependencies": {
		"@storybook/addon-docs": "^10.6.1",
		"@storybook/addon-svelte-csf": "^5.1.5",
		"@storybook/addon-themes": "^10.6.1",
		"@storybook/svelte-vite": "^10.6.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.20.5",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.12.0",
		"eslint-plugin-storybook": "^10.6.1",
		"playwright": "^1.64.0",
		"prettier": "^3.9.10",
		"storybook": "^10.6.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.1.0"
	}
}
