  facet text [not null, default: `'recognise'::text`, note: 'recognise, date, style']
  due "timestamp with time zone" [not null]
  stability "double precision" [not null]
  difficulty "double precision" [not null]
  state smallint [not null]
  reps integer [not null, default: `0`]
  lapses integer [not null, default: `0`]
  scheduled_days integer [not null, default: `0`]
  learning_steps integer [not null, default: `0`]
  last_review "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]
  last_rating smallint

  indexes {
    (artwork_id, facet) [pk]
    (owner_id, due) [name: 'review_cards_owner_id_due_idx']
  }
  Note: 'RLS on'
}

Table review_log {
  id bigint [pk, increment]
  artwork_id uuid [not null]
  owner_id uuid [not null, default: `auth.uid()`]
  facet text [not null, default: `'recognise'::text`, note: 'recognise, date, style, pair']
  mode text [not null, note: 'flashcard, quiz_image, quiz_title, quiz_author, quiz_style, quiz_pin, quiz_typed, year, pair_author, pair_style']
  rating smallint [not null]
  correct boolean
  answer_ms integer
  reviewed_at "timestamp with time zone" [not null, default: `now()`]
  due_before "timestamp with time zone"
  guessed_year integer
  year_miss integer
  wrong_answer text
  practice boolean [not null, default: `false`]
  pair "text[]"

  indexes {
    (artwork_id, reviewed_at) [name: 'review_log_artwork_id_reviewed_at_idx']
    (owner_id, reviewed_at) [name: 'review_log_owner_id_reviewed_at_idx']
  }
  Note: 'RLS on'
}

Table style_details {
  value_id uuid [pk]
  owner_id uuid [not null, default: `auth.uid()`]
  category_code text [not null, default: `'style'::text`]
  summary text
  notes text
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    owner_id [name: 'style_details_owner_id_idx']
  }
  Note: 'RLS on'
}

Table style_periods {
  style_id uuid [not null]
  period_id uuid [not null]
  owner_id uuid [not null, default: `auth.uid()`]

  indexes {
    (style_id, period_id) [pk]
    period_id [name: 'style_periods_period_id_idx']
  }
  Note: 'RLS on'
}

Table symbol_meaning_contexts {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [not null, default: `auth.uid()`]
  meaning_id uuid [not null]
  position smallint [not null]
  value_id uuid
  era_code text
  artwork_id uuid
  glossary_entry_id uuid
  text text

  indexes {
    (meaning_id, position) [unique]
    artwork_id [name: 'symbol_meaning_contexts_artwork_id_idx', note: 'where (artwork_id IS NOT NULL)']
    era_code [name: 'symbol_meaning_contexts_era_code_idx', note: 'where (era_code IS NOT NULL)']
    glossary_entry_id [name: 'symbol_meaning_contexts_glossary_entry_id_idx', note: 'where (glossary_entry_id IS NOT NULL)']
    value_id [name: 'symbol_meaning_contexts_value_id_idx', note: 'where (value_id IS NOT NULL)']
  }
  Note: 'RLS on'
}

Table symbol_meanings {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [not null, default: `auth.uid()`]
  symbol_id uuid [not null]
  position smallint [not null]
  text text [not null]

  indexes {
    (id, owner_id) [unique]
    (id, symbol_id) [unique]
    (symbol_id, position) [unique]
  }
  Note: 'RLS on'
}

Table symbols {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [not null, default: `auth.uid()`]
  name text [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  cover_pin_id uuid
  description text

  indexes {
    (id, owner_id) [unique]
    cover_pin_id [name: 'symbols_cover_pin_id_idx', note: 'where (cover_pin_id IS NOT NULL)']
    (owner_id, `lower(name)`) [name: 'symbols_name_key', unique]
  }
  Note: 'RLS on'
}

Table timeline_events {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [not null, default: `auth.uid()`]
  name text [not null]
  year_from integer
  year_to integer [not null]
  year_approximate boolean [not null, default: `false`]
  description text
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  source_title text
  source_url text
  source_licence text
  source_fetched_on date

  indexes {
    (id, owner_id) [unique]
    (owner_id, year_to) [name: 'timeline_events_owner_year_to_idx']
  }
  Note: 'RLS on'
}

Table visit_artworks {
  visit_id uuid [not null]
  artwork_id uuid [not null]
  owner_id uuid [not null, default: `auth.uid()`]

  indexes {
    (visit_id, artwork_id) [pk]
    artwork_id [name: 'visit_artworks_artwork_id_idx']
    owner_id [name: 'visit_artworks_owner_id_idx']
  }
  Note: 'RLS on'
}

Table visits {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [not null, default: `auth.uid()`]
  place_id uuid [not null]
  category_code text [not null, default: `'location'::text`]
  visited_on date [not null]
  date_precision text [not null, note: 'day, month, year']
  notes text
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  kind text [not null, default: `'visit'::text`, note: 'visit, trip']
  ends_on date
  trip_id uuid

  indexes {
    (id, owner_id) [unique]
    (owner_id, `visited_on DESC`) [name: 'visits_owner_visited_on_idx']
    place_id [name: 'visits_place_id_idx']
    trip_id [name: 'visits_trip_id_idx']
  }
  Note: 'RLS on'
}

