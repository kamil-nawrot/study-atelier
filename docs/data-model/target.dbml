// Target schema: current.dbml with the changes M1-M4 of coverage.yaml.
// Every change carries a note naming it; the rest is the same as current.dbml.

Table auth.users {
  id uuid [pk]
  Note: 'Supabase Auth'
}

Table announcements {
  id uuid [pk, default: `gen_random_uuid()`]
  title text
  body text [not null]
  starts_at "timestamp with time zone" [not null, default: `now()`]
  ends_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]
  Note: 'RLS on'
}

Table artwork_field_entries {
  artwork_id uuid [not null]
  field_id uuid [not null]
  owner_id uuid [not null, default: `auth.uid()`]
  field_kind text [not null]
  text_value text

  indexes {
    (artwork_id, field_id) [pk]
    field_id [name: 'artwork_field_entries_field_id_idx']
    owner_id [name: 'artwork_field_entries_owner_id_idx']
  }
  Note: 'RLS on'
}

Table artwork_fields {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [not null, default: `auth.uid()`]
  name text [not null]
  description text
  kind text [not null]
  multiple boolean [not null, default: `false`]
  position smallint [not null, default: `0`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (id, owner_id) [unique]
    (id, owner_id, kind) [unique]
    (owner_id, position) [unique]
    (owner_id, `lower(name)`) [name: 'artwork_fields_name_key', unique]
  }
  Note: 'RLS on'
}

Table artwork_images {
  artwork_id uuid [not null]
  owner_id uuid [not null, default: `auth.uid()`]
  position smallint [not null]
  source_wikidata_id text
  source_image_file text
  source_image_licence text
  source_image_licence_url text
  source_image_attribution text
  own_image_path text
  own_image_url text
  image_width integer
  image_height integer
  id uuid [pk, default: `gen_random_uuid()`]

  indexes {
    (artwork_id, position) [unique]
    (id, owner_id) [unique]
  }
  Note: 'RLS on'
}

Table artwork_pins {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [not null, default: `auth.uid()`]
  image_id uuid [not null]
  x "double precision" [not null]
  y "double precision" [not null]
  glossary_entry_id uuid
  text text
  created_at "timestamp with time zone" [not null, default: `now()`]
  view_width "double precision"

  indexes {
    glossary_entry_id [name: 'artwork_pins_glossary_entry_id_idx', note: 'where (glossary_entry_id IS NOT NULL)']
    image_id [name: 'artwork_pins_image_id_idx']
    owner_id [name: 'artwork_pins_owner_id_idx', note: 'M4']
  }
  Note: 'RLS on'
}

Table artwork_types {
  code text [pk]
  position smallint [not null]

  indexes {
    (position) [unique]
  }
  Note: 'RLS on'
}

Table artwork_values {
  artwork_id uuid [not null]
  value_id uuid [not null]
  owner_id uuid [not null, default: `auth.uid()`]
  position smallint [not null, default: `0`]

  indexes {
    (artwork_id, value_id) [pk]
    owner_id [name: 'artwork_values_owner_id_idx']
    value_id [name: 'artwork_values_value_id_idx']
  }
  Note: 'RLS on'
}

Table artworks {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [not null, default: `auth.uid()`]
  record_number integer [not null]
  title text [not null]
  author_unknown boolean [not null, default: `false`]
  year_to integer
  year_approximate boolean [not null, default: `false`]
  type_code text
  notes text
  deleted_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  era_code text
  year_from integer
  favourite boolean [not null, default: `false`]

  indexes {
    (id, owner_id) [unique]
    (owner_id, record_number) [unique]
    era_code [name: 'artworks_era_code_idx']
    (owner_id, `search_key(title)`) [name: 'artworks_title_key_idx', note: 'where (deleted_at IS NULL)']
  }
  Note: 'RLS on'
}

Table author_details {
  value_id uuid [pk]
  owner_id uuid [not null, default: `auth.uid()`]
  category_code text [not null, default: `'author'::text`]
  summary text
  notes text
  birth_year integer
  death_year integer
  years_approximate boolean [not null, default: `false`]
  sort_name text
  source_wikidata_id text
  source_image_file text
  source_image_licence text
  source_image_licence_url text
  source_image_attribution text
  own_image_path text
  own_image_url text
  image_width integer
  image_height integer
  updated_at "timestamp with time zone" [not null, default: `now()`]
  Note: 'RLS on'
}

Table catalogue_museums {
  wikidata_id text [pk]
  name text [not null]
  english_name text
  country_code text [not null]

  indexes {
    `lower(name)` [name: 'catalogue_museums_name_key', unique]
  }
  Note: 'RLS on'
}

Table categories {
  code text [pk]
  multiple boolean [not null]
  position smallint
  owner_id uuid
  field_id uuid

  indexes {
    (field_id) [unique]
    position [name: 'categories_position_key', unique, note: 'where (field_id IS NULL)']
  }
  Note: 'RLS on'
}

Table category_values {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [not null, default: `auth.uid()`]
  category_code text [not null]
  name text [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (id, owner_id, category_code) [unique]
    (id, owner_id) [unique]
    (owner_id, category_code, `lower(name)`) [name: 'category_values_name_key', unique]
    category_code [name: 'category_values_category_code_idx', note: 'M4']
  }
  Note: 'RLS on'
}

Table era_details {
  owner_id uuid [not null, default: `auth.uid()`]
  era_code text [not null]
  summary text
  notes text
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (owner_id, era_code) [pk]
  }
  Note: 'RLS on'
}

Table eras {
  code text [pk]
  position smallint [not null]

  indexes {
    (position) [unique]
  }
  Note: 'RLS on'
}

Table exhibit_tiers {
  owner_id uuid [not null, default: `auth.uid()`]
  exhibit text [not null]
  tier smallint [not null]
  unlocked_at "timestamp with time zone" [not null, default: `now()`]
  seen_at "timestamp with time zone"

  indexes {
    (owner_id, exhibit, tier) [pk]
  }
  Note: 'RLS on'
}

Table feedback {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [not null, default: `auth.uid()`]
  kind text [not null]
  title text [not null]
  description text
  created_at "timestamp with time zone" [not null, default: `now()`]
  browser text
  notified_at "timestamp with time zone"

  indexes {
    (owner_id, created_at) [name: 'feedback_owner_id_created_at_idx']
  }
  Note: 'RLS on'
}

Table free_review_days {
  owner_id uuid [not null, default: `auth.uid()`]
  day_start "timestamp with time zone" [not null]
  answers integer [not null]

  indexes {
    (owner_id, day_start) [pk]
  }
  Note: 'RLS on'
}

Table glossary_entries {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [not null, default: `auth.uid()`]
  name text [not null]
  category text [not null]
  definition text
  forms "text[]" [not null, default: `'{}'::text[]`]
  source_title text
  source_url text
  source_licence text
  source_fetched_on date
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  synonyms "text[]" [not null, default: `'{}'::text[]`]
  sort_name text

  indexes {
    (id, owner_id) [unique]
    (owner_id, `lower(name)`) [name: 'glossary_entries_name_key', unique]
  }
  Note: 'RLS on'
}

Table location_details {
  value_id uuid [pk]
  owner_id uuid [not null, default: `auth.uid()`]
  category_code text [not null, default: `'location'::text`]
  summary text
  notes text
  country_code text
  place_type text
  updated_at "timestamp with time zone" [not null, default: `now()`]
  catalogue_wikidata_id text
  Note: 'RLS on'
}

Table material_details {
  value_id uuid [pk]
  owner_id uuid [not null, default: `auth.uid()`]
  category_code text [not null, default: `'material'::text`]
  summary text
  notes text
  updated_at "timestamp with time zone" [not null, default: `now()`]
  Note: 'RLS on'
}

Table period_details {
  value_id uuid [pk]
  owner_id uuid [not null, default: `auth.uid()`]
  category_code text [not null, default: `'period'::text`]
  summary text
  notes text
  updated_at "timestamp with time zone" [not null, default: `now()`]
  Note: 'RLS on'
}

Table period_eras {
  value_id uuid [not null]
  era_code text [not null]
  owner_id uuid [not null, default: `auth.uid()`]

  indexes {
    (value_id, era_code) [pk]
    era_code [name: 'period_eras_era_code_idx']
  }
  Note: 'RLS on'
}

Table point_events {
  id bigint [pk]
  owner_id uuid [not null, default: `auth.uid()`]
  kind text [not null]
  item_id uuid
  day_start "timestamp with time zone"
  plan_share real
  streak_days integer
  occurred_at "timestamp with time zone" [not null, default: `now()`]
  code text

  indexes {
    (owner_id, code) [name: 'point_events_code_idx', unique, note: 'where (kind = \'easter_egg\'::text)']
    (owner_id, day_start) [name: 'point_events_day_idx', unique, note: 'where (kind = \'plan_day\'::text)']
    (owner_id, kind, item_id) [name: 'point_events_item_idx', unique, note: 'where (item_id IS NOT NULL)']
    owner_id [name: 'point_events_owner_idx']
  }
  Note: 'RLS on'
}

Table profiles {
  owner_id uuid [pk, default: `auth.uid()`]
  display_name text
  avatar_path text
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  review_session_size smallint [not null, default: `20`]
  review_new_per_day smallint [not null, default: `10`]
  review_form text [not null, default: `'mixed'::text`]
  review_quiz_kinds "text[]" [not null, default: `ARRAY['quiz_title'::text, 'quiz_image'::text, 'quiz_author'::text, 'quiz_style'::text, 'quiz_pin'::text]`]
  review_free boolean [not null, default: `true`]
  view_show_pins boolean [not null, default: `false`]
  view_loupe_on boolean [not null, default: `false`]
  fetch_image boolean [not null, default: `true`]
  fetch_definition boolean [not null, default: `true`]
  fetch_forms boolean [not null, default: `true`]
  fetch_event boolean [not null, default: `true`]
  legal_version text
  legal_accepted_at "timestamp with time zone"
  review_glossary_questions smallint [not null, default: `1`]
  rank_form text [not null, default: `'masculine'::text`]
  career_shown boolean [not null, default: `true`]
  rank_seen smallint [not null, default: `0`]
  Note: 'RLS on'
}

Table review_cards {
  artwork_id uuid [not null]
  owner_id uuid [not null, default: `auth.uid()`]
  facet text [not null, default: `'recognise'::text`]
  due "timestamp with time zone" [not null]
  stability "double precision" [not null]
  difficulty "double precision" [not null]
  state smallint [not null]
  reps integer [not null, default: `0`]
  lapses integer [not null, default: `0`]
  scheduled_days integer [not null, default: `0`]
  learning_steps integer [not null, default: `0`]
  last_review "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (artwork_id, facet) [pk]
    (owner_id, due) [name: 'review_cards_owner_id_due_idx']
  }
  Note: 'RLS on'
}

Table review_log {
  id bigint [pk]
  artwork_id uuid [not null]
  owner_id uuid [not null, default: `auth.uid()`]
  facet text [not null, default: `'recognise'::text`]
  mode text [not null]
  rating smallint [not null]
  correct boolean
  answer_ms integer
  reviewed_at "timestamp with time zone" [not null, default: `now()`]
  due_before "timestamp with time zone"

  indexes {
    (artwork_id, reviewed_at) [name: 'review_log_artwork_id_reviewed_at_idx']
    (owner_id, reviewed_at) [name: 'review_log_owner_id_reviewed_at_idx']
  }
  Note: 'RLS on'
}

Table style_details {
  value_id uuid [pk]
  owner_id uuid [not null, default: `auth.uid()`]
  category_code text [not null, default: `'style'::text`]
  summary text
  notes text
  updated_at "timestamp with time zone" [not null, default: `now()`]
  Note: 'RLS on'
}

Table style_periods {
  style_id uuid [not null]
  period_id uuid [not null]
  owner_id uuid [not null, default: `auth.uid()`]

  indexes {
    (style_id, period_id) [pk]
    period_id [name: 'style_periods_period_id_idx']
  }
  Note: 'RLS on'
}

Table timeline_events {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [not null, default: `auth.uid()`]
  name text [not null]
  year_from integer
  year_to integer [not null]
  year_approximate boolean [not null, default: `false`]
  description text
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  source_title text
  source_url text
  source_licence text
  source_fetched_on date

  indexes {
    (owner_id, year_to) [name: 'timeline_events_owner_year_to_idx']
  }
  Note: 'RLS on'
}

Table visit_artworks {
  visit_id uuid [not null]
  artwork_id uuid [not null]
  owner_id uuid [not null, default: `auth.uid()`]

  indexes {
    (visit_id, artwork_id) [pk]
    artwork_id [name: 'visit_artworks_artwork_id_idx']
    owner_id [name: 'visit_artworks_owner_id_idx']
  }
  Note: 'RLS on'
}

Table visits {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [not null, default: `auth.uid()`]
  place_id uuid [not null]
  category_code text [not null, default: `'location'::text`]
  visited_on date [not null]
  date_precision text [not null]
  notes text
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (id, owner_id) [unique]
    (owner_id, `visited_on DESC`) [name: 'visits_owner_visited_on_idx']
    place_id [name: 'visits_place_id_idx']
  }
  Note: 'RLS on'
}

Ref artwork_field_entries_artwork_id_owner_id_fkey: artwork_field_entries.(artwork_id, owner_id) > artworks.(id, owner_id) [delete: cascade]
Ref artwork_field_entries_field_id_owner_id_field_kind_fkey: artwork_field_entries.(field_id, owner_id, field_kind) > artwork_fields.(id, owner_id, kind) [delete: cascade]
Ref artwork_fields_owner_id_fkey: artwork_fields.owner_id > auth.users.id [delete: cascade]
Ref artwork_images_artwork_id_owner_id_fkey: artwork_images.(artwork_id, owner_id) > artworks.(id, owner_id) [delete: cascade]
Ref artwork_pins_glossary_entry_id_owner_id_fkey: artwork_pins.(glossary_entry_id, owner_id) > glossary_entries.(id, owner_id) [delete: set null]
Ref artwork_pins_image_id_owner_id_fkey: artwork_pins.(image_id, owner_id) > artwork_images.(id, owner_id) [delete: cascade]
Ref artwork_pins_owner_id_fkey: artwork_pins.owner_id > auth.users.id [delete: cascade]
Ref artwork_values_artwork_id_owner_id_fkey: artwork_values.(artwork_id, owner_id) > artworks.(id, owner_id) [delete: cascade]
Ref artwork_values_value_id_owner_id_fkey: artwork_values.(value_id, owner_id) > category_values.(id, owner_id) [delete: cascade]
Ref artworks_era_code_fkey: artworks.era_code > eras.code
Ref artworks_owner_id_fkey: artworks.owner_id > auth.users.id [delete: cascade]
Ref artworks_type_code_fkey: artworks.type_code > artwork_types.code
Ref author_details_value_id_owner_id_category_code_fkey: author_details.(value_id, owner_id, category_code) > category_values.(id, owner_id, category_code) [delete: cascade]
Ref categories_field_fkey: categories.(field_id, owner_id) > artwork_fields.(id, owner_id) [delete: cascade]
Ref categories_owner_id_fkey: categories.owner_id > auth.users.id [delete: cascade]
Ref category_values_category_code_fkey: category_values.category_code > categories.code [delete: cascade]
Ref category_values_owner_id_fkey: category_values.owner_id > auth.users.id [delete: cascade]
Ref era_details_era_code_fkey: era_details.era_code > eras.code
Ref era_details_owner_id_fkey: era_details.owner_id > auth.users.id [delete: cascade]
Ref exhibit_tiers_owner_id_fkey: exhibit_tiers.owner_id > auth.users.id [delete: cascade]
Ref feedback_owner_id_fkey: feedback.owner_id > auth.users.id [delete: cascade]
Ref free_review_days_owner_id_fkey: free_review_days.owner_id > auth.users.id [delete: cascade]
Ref glossary_entries_owner_id_fkey: glossary_entries.owner_id > auth.users.id [delete: cascade]
Ref location_details_catalogue_wikidata_id_fkey: location_details.catalogue_wikidata_id > catalogue_museums.wikidata_id [delete: set null]
Ref location_details_value_id_owner_id_category_code_fkey: location_details.(value_id, owner_id, category_code) > category_values.(id, owner_id, category_code) [delete: cascade]
Ref material_details_value_id_owner_id_category_code_fkey: material_details.(value_id, owner_id, category_code) > category_values.(id, owner_id, category_code) [delete: cascade]
Ref period_details_value_id_owner_id_category_code_fkey: period_details.(value_id, owner_id, category_code) > category_values.(id, owner_id, category_code) [delete: cascade]
Ref period_eras_era_code_fkey: period_eras.era_code > eras.code
Ref period_eras_value_id_owner_id_fkey: period_eras.(value_id, owner_id) > category_values.(id, owner_id) [delete: cascade]
Ref point_events_owner_id_fkey: point_events.owner_id > auth.users.id [delete: cascade]
Ref profiles_owner_id_fkey: profiles.owner_id > auth.users.id [delete: cascade]
Ref review_cards_artwork_id_owner_id_fkey: review_cards.(artwork_id, owner_id) > artworks.(id, owner_id) [delete: cascade]
Ref review_log_artwork_id_owner_id_fkey: review_log.(artwork_id, owner_id) > artworks.(id, owner_id) [delete: cascade]
Ref style_details_value_id_owner_id_category_code_fkey: style_details.(value_id, owner_id, category_code) > category_values.(id, owner_id, category_code) [delete: cascade]
Ref style_periods_period_id_owner_id_fkey: style_periods.(period_id, owner_id) > category_values.(id, owner_id) [delete: cascade]
Ref style_periods_style_id_owner_id_fkey: style_periods.(style_id, owner_id) > category_values.(id, owner_id) [delete: cascade]
Ref timeline_events_owner_id_fkey: timeline_events.owner_id > auth.users.id [delete: cascade]
Ref visit_artworks_artwork_id_owner_id_fkey: visit_artworks.(artwork_id, owner_id) > artworks.(id, owner_id) [delete: cascade]
Ref visit_artworks_owner_id_fkey: visit_artworks.owner_id > auth.users.id [delete: cascade]
Ref visit_artworks_visit_id_owner_id_fkey: visit_artworks.(visit_id, owner_id) > visits.(id, owner_id) [delete: cascade]
Ref visits_owner_id_fkey: visits.owner_id > auth.users.id [delete: cascade]
Ref visits_place_id_owner_id_category_code_fkey: visits.(place_id, owner_id, category_code) > category_values.(id, owner_id, category_code)

Table note_links {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [not null, default: `auth.uid()`]
  source_artwork_id uuid
  source_value_id uuid
  source_era_code text
  source_visit_id uuid
  target_artwork_id uuid
  target_value_id uuid
  target_era_code text

  indexes {
    (source_artwork_id, source_value_id, source_era_code, source_visit_id, target_artwork_id, target_value_id, target_era_code) [name: 'note_links_key', unique, note: 'nulls not distinct']
    source_value_id [name: 'note_links_source_value_idx', note: 'where (source_value_id IS NOT NULL)']
    (owner_id, source_era_code) [name: 'note_links_source_era_idx', note: 'where (source_era_code IS NOT NULL)']
    source_visit_id [name: 'note_links_source_visit_idx', note: 'where (source_visit_id IS NOT NULL)']
    target_artwork_id [name: 'note_links_target_artwork_idx', note: 'where (target_artwork_id IS NOT NULL)']
    target_value_id [name: 'note_links_target_value_idx', note: 'where (target_value_id IS NOT NULL)']
    (owner_id, target_era_code) [name: 'note_links_target_era_idx', note: 'where (target_era_code IS NOT NULL)']
    owner_id [name: 'note_links_owner_id_idx']
  }
  Note: '''
  M1. One row per link from a note to a subject, extracted from the Markdown by a trigger on every notes column.
  check: num_nonnulls(source_artwork_id, source_value_id, source_era_code, source_visit_id) = 1
  check: num_nonnulls(target_artwork_id, target_value_id, target_era_code) = 1
  Written only by the triggers (no insert, update or delete grant); select for the owner. RLS on.
  Row limit per account (private.limit_rows, ADR-0133).
  '''
}

Table term_mentions {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [not null, default: `auth.uid()`]
  term_id uuid [not null]
  source_artwork_id uuid
  source_value_id uuid
  source_era_code text
  source_visit_id uuid
  source_term_id uuid

  indexes {
    (term_id, source_artwork_id, source_value_id, source_era_code, source_visit_id, source_term_id) [name: 'term_mentions_key', unique, note: 'nulls not distinct']
    source_artwork_id [name: 'term_mentions_source_artwork_idx', note: 'where (source_artwork_id IS NOT NULL)']
    source_value_id [name: 'term_mentions_source_value_idx', note: 'where (source_value_id IS NOT NULL)']
    (owner_id, source_era_code) [name: 'term_mentions_source_era_idx', note: 'where (source_era_code IS NOT NULL)']
    source_visit_id [name: 'term_mentions_source_visit_idx', note: 'where (source_visit_id IS NOT NULL)']
    source_term_id [name: 'term_mentions_source_term_idx', note: 'where (source_term_id IS NOT NULL)']
    owner_id [name: 'term_mentions_owner_id_idx']
  }
  Note: '''
  M2. One row per term found in a note or in another term's definition.
  check: num_nonnulls(source_artwork_id, source_value_id, source_era_code, source_visit_id, source_term_id) = 1
  Filled by triggers: a saved note is matched against the owner's terms; a saved term (name, synonyms, forms) is matched against all notes of the owner.
  Matching follows the browser rule: case-insensitive, phrase between non-letter, non-digit characters.
  Written only by the triggers; select for the owner. RLS on. Row limit per account.
  '''
}

