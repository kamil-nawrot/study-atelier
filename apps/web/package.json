{
	"name": "@study-atelier/web",
	"private": true,
	"version": "0.4.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check --env-file /dev/null && vite build",
		"preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check --env-file /dev/null && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && stylelint --config ../../stylelint.config.js \"src/**/*.{css,svelte}\"",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run",
		"test:coverage": "vitest --run --coverage",
		"gen": "wrangler types --env-file /dev/null",
		"screenshot": "node scripts/screenshot/screenshot.mjs"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.55.0",
		"@study-atelier/ui": "workspace:*",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.4.1",
		"playwright": "^1.64.0",
		"prettier": "^3.8.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@supabase/supabase-js": "2.117.2",
		"ts-fsrs": "5.4.2"
	}
}
