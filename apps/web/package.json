{
	"name": "@study-atelier/web",
	"private": true,
	"version": "0.22.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check --env-file /dev/null && vite build",
		"preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check --env-file /dev/null && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && stylelint --config ../../stylelint.config.js \"src/**/*.{css,svelte}\" && node ../../lint/check-limits.js --layout src/lib && pnpm lint:deps",
		"lint:deps": "depcruise src --ignore-known .dependency-cruiser-known-violations.json && depcruise src --config .dependency-cruiser-modules.cjs --ignore-known .dependency-cruiser-known-module-cycles.json",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run",
		"test:coverage": "vitest --run --coverage",
		"test:e2e": "playwright test",
		"gen": "wrangler types --env-file /dev/null",
		"screenshot": "node scripts/screenshot/screenshot.mjs"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.55.0",
		"@playwright/test": "^1.64.0",
		"@sentry/vite-plugin": "^5.4.1",
		"@study-atelier/ui": "workspace:*",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/d3-geo": "^3.1.1",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^22",
		"@types/topojson-client": "^3.1.5",
		"@types/topojson-specification": "^1.0.5",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"dependency-cruiser": "^18.7.0",
		"eslint": "^10.4.1",
		"playwright": "^1.64.0",
		"prettier": "^3.8.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^3.1.0",
		"world-atlas": "2.0.2",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@sentry/svelte": "11.7.0",
		"@supabase/supabase-js": "2.117.2",
		"@tiptap/core": "^3.31.4",
		"@tiptap/extension-list": "^3.31.4",
		"@tiptap/pm": "^3.31.4",
		"@tiptap/starter-kit": "^3.31.4",
		"d3-geo": "3.1.1",
		"fflate": "0.8.3",
		"topojson-client": "3.1.0",
		"ts-fsrs": "5.4.2"
	}
}
