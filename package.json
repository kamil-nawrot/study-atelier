{
	"name": "study-atelier",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm --filter @study-atelier/web dev",
		"storybook": "pnpm --filter @study-atelier/ui storybook",
		"tokens": "pnpm --filter @study-atelier/ui tokens",
		"build": "pnpm -r build",
		"check": "pnpm -r check",
		"lint": "pnpm -r lint",
		"format": "pnpm -r format",
		"test": "pnpm -r test",
		"screenshot": "pnpm --filter @study-atelier/web screenshot",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:reset": "supabase db reset",
		"db:status": "supabase status",
		"db:env": "supabase status -o env"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"postcss-html": "^2.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"stylelint": "^17.16.0",
		"stylelint-config-html": "^2.0.0",
		"stylelint-declaration-strict-value": "^1.12.1",
		"supabase": "2.120.0",
		"typescript-eslint": "^8.71.1"
	}
}
