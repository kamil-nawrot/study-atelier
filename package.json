{
	"name": "study-atelier",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm --filter @study-atelier/web dev",
		"storybook": "pnpm --filter @study-atelier/ui storybook",
		"tokens": "pnpm --filter @study-atelier/ui tokens",
		"build": "pnpm -r build",
		"check": "pnpm -r check",
		"lint": "pnpm -r lint",
		"format": "pnpm -r format",
		"test": "pnpm -r test"
	}
}
